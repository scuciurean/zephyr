&i2c0 {
	status = "okay";

    hudsonpmic: pmic@10 {
		status = "okay";
        compatible = "adi,hudson-pmic";
        reg = <0x10>;

		buck0: buck0 {
			status = "okay";
			adi,turn-on-delay-us = <100>;
			adi,turn-off-delay-us = <100>;
			adi,rok-delay-us = <50>;
			adi,trim-ilr = <0>;
			adi,trim-vreg = <0>;
		};

		buck1: buck1 {
			status = "okay";
			regulator-always-on;
			adi,turn-on-delay-us = <100>;
			adi,turn-off-delay-us = <100>;
			adi,rok-delay-us = <50>;
		};

		buck2: buck2 {
			status = "okay";
			regulator-always-on;
			adi,turn-on-delay-us = <100>;
			adi,turn-off-delay-us = <100>;
			adi,rok-delay-us = <50>;
		};

		ldo0: ldo0 {
			status = "okay";
			adi,turn-on-delay-us = <50>;
			adi,turn-off-delay-us = <50>;
		};

		ldo1: ldo1 {
			status = "okay";
			adi,turn-on-delay-us = <50>;
			adi,turn-off-delay-us = <50>;
		};

		ldo2: ldo2 {
			status = "okay";
			adi,turn-on-delay-us = <50>;
			adi,turn-off-delay-us = <50>;
		};

		ldo3: ldo3 {
			status = "okay";
			adi,turn-on-delay-us = <50>;
			adi,turn-off-delay-us = <50>;
		};
    };
};
