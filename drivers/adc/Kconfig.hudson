config ADC_HUDSON
	bool "HUDSON ADC driver"
	default y
	depends on DT_HAS_ADI_HUDSON_ADC_ENABLED
	select I2c
	help
	  Enable the HUDSON ADC driver.

config ADC_HUDSON_THREAD_STACK_SIZE
	int "Stack size for the ADC data acquisition thread"
	depends on ADC_HUDSON
	default 512
	help
	  Size of the stack used for the internal data acquisition
	  thread.

config ADC_HUDSON_THREAD_PRIO
	int "Priority for the ADC data acquisition thread"
	depends on ADC_HUDSON
	default 0
	help
	  Priority level for the internal ADC data acquisition thread.
